@model CreateEmployeeViewModel
@{
    ViewData["Title"] = "Add Employee";
}

<div class="row justify-content-center">
<div class="col-lg-6">
    <div class="card shadow-sm">
        <div class="card-header nd-card-header">
            <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Add New Employee</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="employee@thegarden.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select"
                                asp-items="@(ViewBag.Roles as IEnumerable<SelectListItem>)">
                            <option value="">— Select role —</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartmentName" class="form-label fw-semibold"></label>
                        <select asp-for="DepartmentName" class="form-select"
                                asp-items="@(ViewBag.Departments as IEnumerable<SelectListItem>)">
                            <option value="">— Select department —</option>
                        </select>
                        <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn nd-btn-primary">
                        <i class="bi bi-person-check me-1"></i> CREATE EMPLOYEE
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">CANCEL</a>
                </div>
            </form>
        </div>
    </div>
</div>
</div>
