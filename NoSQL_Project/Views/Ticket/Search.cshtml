@model List<TicketDisplayViewModel>
@{
    ViewData["Title"] = "Search Results";
    bool isSD = User.IsInRole("ServiceDesk");
    string q    = ViewBag.Query ?? "";
    string mode = ViewBag.Mode  ?? "and";
}
<!-- Individual feature: Ticket Search -->

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0">Search Results</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to list
    </a>
</div>

<form asp-action="Search" method="get" class="d-flex gap-2 mb-4">
    <input type="text" name="q" class="form-control" value="@q"
           placeholder="Search by keyword…" style="max-width:320px;" />
    <select name="mode" class="form-select" style="max-width:120px;">
        <option value="and" @(mode == "and" ? "selected" : "")>AND (all words)</option>
        <option value="or"  @(mode == "or"  ? "selected" : "")>OR (any word)</option>
    </select>
    <button type="submit" class="btn nd-btn-primary">
        <i class="bi bi-search me-1"></i> Search
    </button>
</form>

@if (!string.IsNullOrWhiteSpace(q))
{
    <p class="text-muted">
        Found <strong>@Model.Count</strong> result(s) for
        <em>"@q"</em> using <strong>@mode.ToUpper()</strong> mode,
        sorted by relevance then date.
    </p>
}

@if (!Model.Any() && !string.IsNullOrWhiteSpace(q))
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-search fs-1"></i>
        <p class="mt-2">No tickets matched your search.</p>
    </div>
}
else if (Model.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="nd-table-head">
                    <tr>
                        <th>Subject</th>
                        <th>User</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vm in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@vm.Ticket.Id"
                                   class="fw-semibold text-decoration-none text-dark">
                                    @vm.Ticket.Title
                                </a>
                            </td>
                            <td>@vm.ReporterName<br/><small class="text-muted">@vm.ReporterEmail</small></td>
                            <td>@vm.Ticket.DateReported.ToString("dd MMM yyyy")</td>
                            <td>
                                @{
                                    var sc = vm.Ticket.Status switch
                                    {
                                        "Open"     => "nd-badge-open",
                                        "Resolved" => "nd-badge-resolved",
                                        "Closed"   => "nd-badge-closed",
                                        _          => "bg-secondary"
                                    };
                                }
                                <span class="badge @sc">@vm.Ticket.Status</span>
                            </td>
                            <td>
                                @{
                                    var pc = vm.Ticket.Priority switch
                                    {
                                        "High"   => "nd-badge-high",
                                        "Normal" => "nd-badge-normal",
                                        "Low"    => "nd-badge-low",
                                        _        => "bg-secondary"
                                    };
                                }
                                <span class="badge @pc">@vm.Ticket.Priority</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@vm.Ticket.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (isSD)
                                {
                                    <a asp-action="Edit" asp-route-id="@vm.Ticket.Id"
                                       class="btn btn-sm btn-outline-primary ms-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
