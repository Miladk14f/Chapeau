@model TicketDisplayViewModel
@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="row justify-content-center">
<div class="col-lg-6">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h5>
        </div>
        <div class="card-body">
            <p>Are you sure you want to permanently delete this ticket?</p>
            <p class="text-muted small">This action cannot be undone.</p>
            <dl class="row">
                <dt class="col-sm-4">Subject</dt>
                <dd class="col-sm-8">@Model.Ticket.Title</dd>
                <dt class="col-sm-4">Reported by</dt>
                <dd class="col-sm-8">@Model.ReporterName</dd>
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Ticket.Status</dd>
            </dl>
            <div class="alert alert-warning small">
                <i class="bi bi-lightbulb me-1"></i>
                Consider changing the status to <strong>Closed</strong> instead of deleting.
            </div>
            <form asp-action="Delete" asp-route-id="@Model.Ticket.Id" method="post"
                  class="d-flex gap-2 mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Yes, Delete Permanently
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
</div>
