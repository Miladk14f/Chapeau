@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
    Layout = null; // No navbar on login page
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NoDesk: TGG — Log in</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
          crossorigin="anonymous" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="nd-login-bg d-flex align-items-center justify-content-center min-vh-100">

<div class="card nd-login-card shadow-lg">
    <div class="card-body p-5">

        <!-- Logo -->
        <div class="text-center mb-4">
            <h1 class="nd-login-title">NoDesk: TGG</h1>
            <p class="text-muted small">Please provide login credentials to login to NoDesk for The Garden Group</p>
        </div>

        @* Error summary *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" id="loginError">
                <i class="bi bi-exclamation-circle me-2"></i>
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@err.ErrorMessage</span>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")"
                       placeholder="your.name@tgg.nl" autocomplete="email" />
                <span asp-validation-for="Email" class="invalid-feedback"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <input asp-for="Password" class="form-control @(ViewData.ModelState.ContainsKey(string.Empty) ? "is-invalid" : "")"
                       placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="invalid-feedback"></span>
            </div>

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Remember Me</label>
                </div>
                <a href="#" class="text-muted small">Forgot Login Details?</a>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn nd-btn-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>
</html>
