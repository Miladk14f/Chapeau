@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0 fw-bold">Dashboard Statistics</h2>
        <small class="text-muted">
            @(User.IsInRole("ServiceDesk") ? "All tickets across all employees" : "Your own tickets")
        </small>
    </div>
    <a asp-controller="Ticket" asp-action="Index" class="btn nd-btn-primary">
        <i class="bi bi-list-ul me-1"></i> SHOW LIST
    </a>
</div>

<div class="row g-4 mb-4">

    <!-- Unresolved / Open Tickets -->
    <div class="col-md-4">
        <div class="card nd-stat-card h-100">
            <div class="card-body d-flex flex-column align-items-center">
                <h5 class="card-title text-center">Unresolved Incidents</h5>
                <p class="text-muted text-center small">All tickets currently open</p>
                <div class="nd-chart-container my-3">
                    <canvas id="openChart"></canvas>
                </div>
                <div class="mt-2 text-center">
                    <span class="nd-big-number text-warning">@Model.StatusCounts.Open</span>
                    <span class="text-muted"> / @Model.StatusCounts.Total total</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Past Deadline -->
    <div class="col-md-4">
        <div class="card nd-stat-card h-100">
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <h5 class="card-title text-center">Incidents Past Deadline</h5>
                <p class="text-muted text-center small">These tickets need your immediate attention</p>
                <div class="nd-big-number text-danger my-3">@Model.PastDeadlineCount</div>
                <small class="text-muted">open tickets past due</small>
            </div>
        </div>
    </div>

    <!-- Status Breakdown -->
    <div class="col-md-4">
        <div class="card nd-stat-card h-100">
            <div class="card-body">
                <h5 class="card-title text-center">Status Breakdown</h5>
                <div class="nd-chart-container my-3">
                    <canvas id="statusChart"></canvas>
                </div>
                <ul class="list-unstyled mt-3">
                    <li class="d-flex justify-content-between py-1 border-bottom">
                        <span><span class="badge nd-badge-open">Open</span></span>
                        <strong>@Model.StatusCounts.OpenPercent%</strong>
                    </li>
                    <li class="d-flex justify-content-between py-1 border-bottom">
                        <span><span class="badge nd-badge-resolved">Resolved</span></span>
                        <strong>@Model.StatusCounts.ResolvedPercent%</strong>
                    </li>
                    <li class="d-flex justify-content-between py-1">
                        <span><span class="badge nd-badge-closed">Closed</span></span>
                        <strong>@Model.StatusCounts.ClosedPercent%</strong>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"
        crossorigin="anonymous"></script>
<script>
(function () {
    const open     = @Model.StatusCounts.Open;
    const resolved = @Model.StatusCounts.Resolved;
    const closed   = @Model.StatusCounts.Closed;
    const total    = @Model.StatusCounts.Total;

    // Donut: open vs rest
    new Chart(document.getElementById('openChart'), {
        type: 'doughnut',
        data: {
            labels: ['Open', 'Resolved / Closed'],
            datasets: [{
                data: [open, total - open],
                backgroundColor: ['#fd7e14', '#dee2e6'],
                borderWidth: 0
            }]
        },
        options: {
            cutout: '70%',
            plugins: { legend: { position: 'bottom', labels: { font: { family: 'Arial' } } } }
        }
    });

    // Donut: all three statuses
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: ['Open', 'Resolved', 'Closed'],
            datasets: [{
                data: [open, resolved, closed],
                backgroundColor: ['#fd7e14', '#198754', '#6c757d'],
                borderWidth: 0
            }]
        },
        options: {
            cutout: '65%',
            plugins: { legend: { position: 'bottom', labels: { font: { family: 'Arial' } } } }
        }
    });
})();
</script>
}
