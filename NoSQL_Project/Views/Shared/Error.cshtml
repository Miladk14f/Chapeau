@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}
<div class="container py-5 text-center">
    <i class="bi bi-exclamation-octagon text-danger" style="font-size:4rem;"></i>
    <h2 class="mt-3">Something went wrong</h2>
    <p class="text-muted">An unexpected error occurred. Please try again or contact your system administrator.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house me-1"></i> Back to Dashboard
    </a>
</div>
